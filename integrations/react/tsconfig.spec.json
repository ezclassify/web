{
    "//": "The adapter-parity suite is reached through a vitest alias (see the root vitest.config.ts), not a package export, so the compiler needs the same mapping or the shared suite typechecks nowhere.",
    "compilerOptions": {
        "noEmit": true,
        "paths": {
            "@ezclassify/ui/adapter-parity-suite": [
                "../../libs/ui/src/store/adapter-parity-suite.ts"
            ]
        },
        "types": ["node", "vite/client", "vitest/globals"]
    },
    "extends": "./tsconfig.json",
    "include": [
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.test.js",
        "src/**/*.spec.js",
        "src/**/*.test.jsx",
        "src/**/*.spec.jsx",
        "src/**/*.d.ts"
    ]
}
