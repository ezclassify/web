{
    "name": "@ezclassify/react",
    "version": "1.0.0-dev.30",
    "type": "module",
    "description": "React integration components for the ezclassify classification engine",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ezclassify/web.git",
        "directory": "integrations/react"
    },
    "homepage": "https://github.com/ezclassify/web/tree/main/integrations/react#readme",
    "bugs": {
        "url": "https://github.com/ezclassify/web/issues"
    },
    "license": "Apache-2.0",
    "main": "./dist/lib/index.cjs",
    "types": "./dist/lib/index.d.ts",
    "module": "./dist/lib/index.mjs",
    "exports": {
        ".": {
            "types": "./dist/lib/index.d.ts",
            "import": "./dist/lib/index.mjs",
            "require": "./dist/lib/index.cjs"
        }
    },
    "files": [
        "NOTICE",
        "dist/",
        "!dist/**/*.map"
    ],
    "keywords": [
        "classification",
        "react",
        "ezclassify",
        "security-classification"
    ],
    "scripts": {
        "build": "node build-lib.mjs",
        "build:watch": "node build-lib.mjs --watch",
        "lint": "npx eslint src/",
        "prepublishOnly": "npm run build && node ../../scripts/check-publish-content.mjs @ezclassify/react",
        "test": "cd ../.. && npx vitest run --config vitest.config.ts",
        "test:verbose": "npx vitest run --reporter=verbose --no-file-parallelism",
        "typecheck": "node ../../scripts/typecheck-specs.mjs integrations/react",
        "verify:publish-ready": "npm run build && npm test && npm pack --dry-run"
    },
    "peerDependencies": {
        "@ezclassify/types": "^1.0.0-0",
        "@ezclassify/ui": "^1.0.0-0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@ezclassify/types": "^1.0.0-0",
        "@ezclassify/ui": "^1.0.0-0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
