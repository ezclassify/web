{
    "name": "@ezclassify/vue",
    "version": "1.0.0-dev.30",
    "type": "module",
    "description": "Vue 3 integration for the EzClassify marking engine",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ezclassify/web.git",
        "directory": "integrations/vue"
    },
    "homepage": "https://github.com/ezclassify/web/tree/main/integrations/vue#readme",
    "bugs": {
        "url": "https://github.com/ezclassify/web/issues"
    },
    "license": "Apache-2.0",
    "main": "./dist/lib/index.cjs",
    "types": "./dist/lib/index.d.ts",
    "module": "./dist/lib/index.mjs",
    "exports": {
        ".": {
            "types": "./dist/lib/index.d.ts",
            "import": "./dist/lib/index.mjs",
            "require": "./dist/lib/index.cjs"
        }
    },
    "files": [
        "NOTICE",
        "dist/",
        "!dist/**/*.map"
    ],
    "keywords": [
        "marking",
        "vue",
        "vue3",
        "ezclassify"
    ],
    "scripts": {
        "build": "node build-lib.mjs",
        "build:watch": "node build-lib.mjs --watch",
        "lint": "npx eslint src/",
        "prepublishOnly": "npm run build && node ../../scripts/check-publish-content.mjs @ezclassify/vue",
        "test": "cd ../.. && npx vitest run --config vitest.config.ts",
        "test:verbose": "npx vitest run --reporter=verbose --no-file-parallelism",
        "typecheck": "node ../../scripts/typecheck-specs.mjs integrations/vue",
        "verify:publish-ready": "npm run build && npm test && npm pack --dry-run"
    },
    "peerDependencies": {
        "@ezclassify/types": "^1.0.0-0",
        "@ezclassify/ui": "^1.0.0-0",
        "vue": ">=3.3.0"
    },
    "devDependencies": {
        "@ezclassify/types": "^1.0.0-0",
        "@ezclassify/ui": "^1.0.0-0",
        "@vue/test-utils": "^2.4.6",
        "vitest": "^5.0.5",
        "vue": "^3.5.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
