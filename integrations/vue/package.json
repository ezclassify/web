{
    "name": "@ezclassify/vue",
    "version": "1.0.0-dev.30",
    "type": "module",
    "description": "Vue 3 component library for security markings and sensitivity labels: validate, combine parts into an overall marking, show the banner. CAPCO, CUI, TLP 2.0, CVSS or your own rules. Needs an EzClassify runtime.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ezclassify/web.git",
        "directory": "integrations/vue"
    },
    "homepage": "https://ezclassify.com/",
    "bugs": {
        "url": "https://github.com/ezclassify/web/issues"
    },
    "license": "Apache-2.0",
    "main": "./dist/lib/index.cjs",
    "types": "./dist/lib/index.d.ts",
    "module": "./dist/lib/index.mjs",
    "exports": {
        ".": {
            "types": "./dist/lib/index.d.ts",
            "import": "./dist/lib/index.mjs",
            "require": "./dist/lib/index.cjs"
        }
    },
    "files": [
        "NOTICE",
        "dist/",
        "!dist/**/*.map"
    ],
    "keywords": [
        "classification-marking",
        "classification-banner",
        "portion-marking",
        "sensitivity-label",
        "data-classification",
        "capco",
        "ism",
        "cui",
        "tlp",
        "cvss",
        "security-marking",
        "banner-line",
        "portion-mark",
        "banner-rollup",
        "cui-marking",
        "cui-banner",
        "marking-picker",
        "vue",
        "ezclassify",
        "classification",
        "marking",
        "library",
        "components",
        "module",
        "package",
        "sdk",
        "component",
        "ui",
        "input",
        "form",
        "widget",
        "plugin"
    ],
    "scripts": {
        "build": "node build-lib.mjs",
        "build:watch": "node build-lib.mjs --watch",
        "lint": "npx eslint src/",
        "prepublishOnly": "npm run build && node ../../scripts/check-publish-content.mjs @ezclassify/vue",
        "test": "cd ../.. && npx vitest run --config vitest.config.ts",
        "test:verbose": "npx vitest run --reporter=verbose --no-file-parallelism",
        "typecheck": "node ../../scripts/typecheck-specs.mjs integrations/vue",
        "verify:publish-ready": "npm run build && npm test && npm pack --dry-run"
    },
    "peerDependencies": {
        "@ezclassify/types": "^1.0.0-0",
        "@ezclassify/ui": "^1.0.0-0",
        "vue": ">=3.3.0"
    },
    "devDependencies": {
        "@ezclassify/types": "^1.0.0-0",
        "@ezclassify/ui": "^1.0.0-0",
        "@vue/test-utils": "^2.4.6",
        "vitest": "^4.1.2",
        "vue": "^3.5.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
