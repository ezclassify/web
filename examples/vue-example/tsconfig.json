{
    "compilerOptions": {
        "isolatedModules": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "useDefineForClassFields": true
    },
    "include": ["src/**/*.ts", "src/**/*.vue"]
}
