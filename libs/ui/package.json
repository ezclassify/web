{
    "name": "@ezclassify/ui",
    "version": "1.0.0-dev.30",
    "type": "module",
    "description": "UI component library for security markings and sensitivity labels: marking and label fields, pickers and document banners for any web page, driven by HTML attributes. Works with CAPCO, CUI, TLP 2.0, CVSS or your own rules. Needs an EzClassify runtime.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ezclassify/web.git",
        "directory": "libs/ui"
    },
    "homepage": "https://ezclassify.com/",
    "bugs": {
        "url": "https://github.com/ezclassify/web/issues"
    },
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "main": "./dist/lib/index.cjs",
    "types": "./dist/lib/index.d.ts",
    "module": "./dist/lib/index.mjs",
    "exports": {
        ".": {
            "types": "./dist/lib/index.d.ts",
            "import": "./dist/lib/index.mjs",
            "require": "./dist/lib/index.cjs"
        },
        "./devtools": {
            "types": "./dist/lib/devtools/index.d.ts",
            "import": "./dist/lib/devtools/index.mjs"
        }
    },
    "files": [
        "NOTICE",
        "dist/lib",
        "!dist/**/*.map"
    ],
    "keywords": [
        "classification-marking",
        "classification-banner",
        "portion-marking",
        "sensitivity-label",
        "data-classification",
        "capco",
        "ism",
        "cui",
        "tlp",
        "cvss",
        "security-marking",
        "banner-line",
        "portion-mark",
        "banner-rollup",
        "cui-marking",
        "cui-banner",
        "marking-picker",
        "forms",
        "ezclassify",
        "classification",
        "marking",
        "library",
        "components",
        "module",
        "package",
        "sdk",
        "component",
        "ui",
        "input",
        "form",
        "widget"
    ],
    "scripts": {
        "build": "npm run build:lib",
        "build:browser": "node build-browser.mjs",
        "build:lib": "node build-lib.mjs",
        "build:watch": "node build-lib.mjs --watch",
        "lint": "npx eslint src/",
        "prepublishOnly": "npm run build:lib && node ../../scripts/check-publish-content.mjs @ezclassify/ui",
        "test": "cd ../.. && npx vitest run --config vitest.config.ts",
        "test:verbose": "cd ../.. && npx vitest run --config vitest.config.ts --reporter=verbose --no-file-parallelism",
        "typecheck": "node ../../scripts/typecheck-specs.mjs libs/ui",
        "verify:publish-ready": "npm run build:lib && npm test && node ../../scripts/check-publish-content.mjs @ezclassify/ui"
    },
    "dependencies": {
        "@ezclassify/types": "^1.0.0-0"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "js-yaml": "^4.1.0",
        "vitest": "^4.1.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
