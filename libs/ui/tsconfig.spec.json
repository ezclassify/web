{
    "//": "The adapter-parity suite is reached through a vitest alias (see vitest.config.ts), not a package export, so the compiler needs the same mapping or the shared suite typechecks nowhere.",
    "compilerOptions": {
        "noEmit": true,
        "paths": {
            "@ezclassify/ui/adapter-parity-suite": [
                "./src/store/adapter-parity-suite.ts"
            ]
        },
        "types": ["node", "vite/client", "vitest/globals"]
    },
    "extends": "./tsconfig.json",
    "include": [
        "vitest.config.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.d.ts",
        "tests/**/*.spec.ts",
        "tests/**/*.d.ts"
    ]
}
