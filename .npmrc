# npm supply-chain hardening: never run dependency install/lifecycle scripts.
ignore-scripts=true

# Keep generated lockfiles registry-neutral. First-party packages can be served
# by different registries in different environments, so no one registry URL is
# portable.
omit-lockfile-registry-resolved=true

# Resolve framework/compiler peers strictly. npm keeps the library's Angular 20
# compiler and TypeScript 5.9 separate from current application tooling.
legacy-peer-deps=false

# The publish-date quarantine for third-party packages is NOT configured here.
# npm's `min-release-age` is tree-wide with no supported way to exempt a scope
# (`min-release-age-exclude` is not an npm setting; npm reports it as an
# unknown project config and ignores it). Setting the window in this file
# therefore quarantines our own freshly published packages too, and `npm ci`
# fails with ETARGET on every @ezclassify dependency. The window lives in
# scripts/check-dependency-age.mjs instead, run as a CI step
# (`npm run check:dependency-age`), where first-party and third-party can be
# told apart.
