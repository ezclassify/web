{
    "entryPointStrategy": "expand",
    "entryPoints": [
        "libs/*/src",
        "integrations/*/src",
        "integrations/angular/schematics",
        "scripts",
        "examples/*/src",
        "libs/*/build-*.mjs",
        "integrations/*/build-*.mjs",
        "vitest.private-runtime.ts",
        "integrations/angular/clean.mjs",
        "e2e/lanes.mjs",
        "e2e/hosts"
    ],
    "exclude": [
        "**/*.spec.*",
        "**/*.test.*",
        "**/*.d.ts",
        "**/__mocks__/**",
        "**/node_modules/**",
        "integrations/angular/schematics/**/*.js"
    ],
    "excludeInternal": false,
    "excludePrivate": false,
    "excludeProtected": false,
    "extends": "./typedoc.json",
    "name": "Web Source Reference (Private)",
    "out": "dist/source-reference"
}
